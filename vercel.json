{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": {
      "description": "The public URL of your application"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL database connection string"
    },
    "NEXTAUTH_URL": {
      "description": "The URL of your NextAuth instance"
    },
    "NEXTAUTH_SECRET": {
      "description": "Secret key for NextAuth (generate with: openssl rand -base64 32)"
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret key for payments"
    },
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key for frontend"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook secret for payment processing"
    },
    "SMTP_HOST": {
      "description": "SMTP server host for email (optional)"
    },
    "SMTP_PORT": {
      "description": "SMTP server port (optional)"
    },
    "SMTP_USER": {
      "description": "SMTP username (optional)"
    },
    "SMTP_PASS": {
      "description": "SMTP password (optional)"
    },
    "FROM_EMAIL": {
      "description": "From email address for emails (optional)"
    },
    "WS_PORT": {
      "description": "WebSocket server port"
    },
    "NEXT_PUBLIC_WS_URL": {
      "description": "WebSocket server URL"
    },
    "ENABLE_REALTIME": {
      "description": "Enable real-time features"
    },
    "ENABLE_STRIPE": {
      "description": "Enable Stripe payments"
    },
    "ENABLE_EMAIL": {
      "description": "Enable email notifications"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhooks/:path*",
      "destination": "/api/webhooks/:path*"
    }
  ]
}
