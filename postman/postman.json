    {
      "name": "8. Machine Learning & Predictive Analytics",
      "item": [
        {
          "name": "Get Anomalies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ml/anomalies?hours=24&deviceId={{deviceId}}&organizationId={{organizationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ml",
                "anomalies"
              ],
              "query": [
                {
                  "key": "hours",
                  "value": "24",
                  "description": "Time window in hours"
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}",
                  "description": "Optional filter by device"
                },
                {
                  "key": "organizationId",
                  "value": "{{organizationId}}",
                  "description": "Filter by organization"
