                "api",
                "auth",
                "csrf"
              ]
            },
            "description": "Retrieve NextAuth CSRF token required for sign-in."
          }
        },
        {
          "name": "Get Providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
