  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL of the application (Local: http://localhost:3000, Prod: https://urjaflow.vercel.app)"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT session token for authenticated requests"
    },
    {
      "key": "organizationId",
      "value": "demo-org-id",
      "type": "string",
      "description": "Sample organization ID for multi-tenant routes"
    },
    {
      "key": "deviceId",
      "value": "demo-device-id",
      "type": "string",
      "description": "Sample device ID for telemetry and ML routes"
    },
    {
      "key": "notificationId",
