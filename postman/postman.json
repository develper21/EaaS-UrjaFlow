    {
      "name": "14. GraphQL API",
      "item": [
        {
          "name": "GraphQL Query - List Devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query GetDevices {\\n  devices {\\n    id\\n    name\\n    type\\n    status\\n    capacity\\n    organization {\\n      id\\n      name\\n    }\\n  }\\n}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "graphql"
              ]
            },
            "description": "Execute GraphQL query to fetch all devices and their organizations."
          }
        },
        {
          "name": "GraphQL Query - Energy Analytics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query GetAnalytics {\\n  analytics {\\n    energyStats {\\n      totalGeneration\\n      totalConsumption\\n      netEnergy\\n      efficiency\\n      carbonOffset\\n      period\\n    }\\n    deviceStats {\\n      deviceId\\n      deviceName\\n      generation\\n      efficiency\\n    }\\n  }\\n}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "graphql"
              ]
            },
            "description": "Execute GraphQL query to fetch calculated energy analytics and carbon offset."
          }
        },
        {
          "name": "GraphQL Mutation - Add Device Reading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation AddReading($input: DeviceReadingInput!) {\\n  addDeviceReading(input: $input) {\\n    id\\n    deviceId\\n    generationKW\\n    consumptionKW\\n    efficiency\\n    timestamp\\n  }\\n}\",\n  \"variables\": {\n    \"input\": {\n      \"deviceId\": \"{{deviceId}}\",\n      \"generationKW\": 35.8,\n      \"consumptionKW\": 22.1,\n      \"batteryPercent\": 92,\n      \"voltage\": 240,\n      \"current\": 15,\n      \"temperature\": 38.5,\n      \"efficiency\": 96\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "graphql"
              ]
            },
            "description": "Execute GraphQL mutation to ingest telemetry reading for a device."
          }
        },
        {
          "name": "GraphQL Mutation - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Login($input: LoginInput!) {\\n  login(input: $input) {\\n    token\\n    user {\\n      id\\n      email\\n      name\\n      role\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"input\": {\n      \"email\": \"admin@urjaflow.com\",\n      \"password\": \"password123\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "graphql"
              ]
            },
            "description": "GraphQL login mutation that returns a JWT token."
          }
        }
      ]
    }
